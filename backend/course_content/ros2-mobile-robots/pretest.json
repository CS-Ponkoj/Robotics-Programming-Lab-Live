        }
      ]
    },
    {
      "id": "q8",
      "prompt": "A sector report should print \"unavailable\" only when the Python float d is NaN. Which condition should trigger that branch?",
      "options": [
        {
          "id": "A",
          "text": "d == float('nan')"
        },
        {
          "id": "B",
          "text": "math.isnan(d)"
        },
        {
          "id": "C",
          "text": "math.isinf(d)"
        },
        {
          "id": "D",
          "text": "not math.isfinite(d)"
        }
      ]
    },
    {
      "id": "q9",
      "prompt": "A LaserScan reports range_min = 0.25 and range_max = 4.0. Under the message definition, is a finite reading of exactly 0.25 discarded?",
      "options": [
        {
          "id": "A",
          "text": "Yes, because it equals the lower limit"
        },
        {
          "id": "B",
          "text": "No, because it is within the inclusive limits"
        },
        {
          "id": "C",
          "text": "Yes, because a reading must be strictly above the lower limit"
        },
        {
          "id": "D",
          "text": "The message definition does not say"
        }
      ]
    },
