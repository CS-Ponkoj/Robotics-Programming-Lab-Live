    {
      "id": "q6",
      "prompt": "A scan-reporting node receives a reading of +inf. Which description matches REP 117?",
      "options": [
        {
          "id": "A",
          "text": "No return was detected within the sensor's range"
        },
        {
          "id": "B",
          "text": "A valid return at exactly range_max"
        },
        {
          "id": "C",
          "text": "An invalid measurement"
        },
        {
          "id": "D",
          "text": "No scan message was received"
        }
      ]
    },
    {
      "id": "q7",
      "prompt": "Which value does REP 117 use for \"something was detected, but it is too close to measure\"?",
      "options": [
        {
          "id": "A",
