  "questions": [
    {
      "id": "q1",
      "prompt": "A student's build_node() creates a node, a publisher and a subscription. Which object must it hand back to the lab's unchanged main()?",
      "options": [
        {
          "id": "A",
          "text": "The publisher"
        },
        {
          "id": "B",
          "text": "The subscription"
        },
        {
          "id": "C",
          "text": "The callback function"
        },
        {
          "id": "D",
          "text": "The configured node"
        }
      ]
    },
    {
      "id": "q2",
      "prompt": "report is a function that takes one Flbr message. Which line registers it to process messages on /flbr?",
      "options": [
        {
          "id": "A",
          "text": "node.create_subscription(Flbr, '/flbr', report, 10)"
        },
        {
          "id": "B",
          "text": "node.create_subscription(Flbr, '/flbr', report(), 10)"
        },
        {
          "id": "C",
          "text": "node.create_subscription(Flbr, '/flbr', 'report', 10)"
        },
        {
          "id": "D",
          "text": "node.create_subscription(report, '/flbr', Flbr, 10)"
        }
      ]
    },
    {
      "id": "q3",
      "prompt": "A node subscribes to /flbr. What does one call of its callback receive?",
      "options": [
        {
          "id": "A",
          "text": "One Flbr message with all four distances"
        },
        {
          "id": "B",
          "text": "Only the front distance"
        },
        {
          "id": "C",
          "text": "Every Flbr message since the program started"
        },
        {
          "id": "D",
          "text": "Ten messages, because the depth is 10"
        }
      ]
    },
