ENVIRONMENT=development
# Copy the Neon pooled connection string into the ignored repository-root .env.
# NEON_DATABASE_URL=postgresql://user:password@example.neon.tech/neondb?sslmode=require
NEON_DATABASE_NAME=robotics_lab_staging
# Development reads NEON_DATABASE_URL and NEON_DATABASE_NAME directly.
# Do not set DATABASE_URL locally; launchers supply the same resolved Neon URL.
# Production supplies its Neon DATABASE_URL through provider secret settings.
AUTO_CREATE_SCHEMA=false
REDIS_URL=redis://127.0.0.1:6379/0
ADMIN_API_TOKEN=replace-with-a-long-random-value
ENABLE_DEMO_ACCOUNTS=true
ENABLE_PASSWORD_RESET=false
ENABLE_EMAIL_FEATURES=false
# Seeded prototype account passwords for a new database. Use strong private
# values (12+ characters); production rejects the built-in defaults.
DEMO_STUDENT_PASSWORD=replace-with-a-strong-student-password
DEMO_INSTRUCTOR_PASSWORD=replace-with-a-strong-instructor-password
# Account roster: backend/data/study_accounts.json (password-free).
PUBLIC_APP_URL=http://127.0.0.1:8080
AUTH_SESSION_HOURS=12
PASSWORD_RESET_MINUTES=30
# Real email delivery requires values supplied by your email provider.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Robotics Programming Lab <no-reply@example.edu>
# SMTP_USE_TLS=true
SANDBOX_BACKEND=subprocess
SANDBOX_IMAGE=robotics-lab-sandbox:latest
# Production uses SANDBOX_BACKEND=remote with values stored only in Render.
# SANDBOX_URL=https://robotics-programming-lab-sandbox.onrender.com
# SANDBOX_API_TOKEN=replace-with-a-random-value-at-least-24-characters
SANDBOX_HTTP_TIMEOUT_SECONDS=75
EXECUTION_TIMEOUT_SECONDS=10
# Assignment 5 runs in this separate ROS 2 Jazzy grading image.
ROS2_GRADER_IMAGE=robotics-lab-ros2-grader:jazzy-v1
OPENAI_HINT_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=7
OPENAI_MAX_RETRIES=0
EXECUTION_REQUESTS_PER_MINUTE=30
TUTOR_REQUESTS_PER_MINUTE=10
MAX_CONCURRENT_EXECUTIONS=2
MAX_REQUEST_BYTES=100000
# OPENAI_API_KEY is optional. Keep it only in the ignored repository-root .env.
