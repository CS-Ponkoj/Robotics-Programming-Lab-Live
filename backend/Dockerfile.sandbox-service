FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1

WORKDIR /sandbox

COPY backend/requirements.sandbox.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && addgroup --system --gid 65532 sandbox \
    && adduser --system --uid 65532 --ingroup sandbox sandbox

COPY backend/sandbox.py backend/submission_worker.py backend/sandbox_service.py ./

USER 65532:65532
EXPOSE 10000

CMD ["sh", "-c", "uvicorn sandbox_service:app --host 0.0.0.0 --port ${PORT:-10000} --no-server-header"]
