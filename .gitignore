# Secrets and local configuration
.env
*.local

# Generated Python environments, caches, and local coverage. These are
# intentionally rebuilt per computer by scripts/setup-local.ps1.
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local application runtime and data
/.local-run/
backend/*.db
backend/managed_assets/
backend/data/study_accounts.json
backend/data/study_accounts_import_report*.json
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
backend/study_exports/
/output/
/outputs/
/tmp/

# Active private local package. Only its safety instructions are tracked.
/local_handoff_package/*
!/local_handoff_package/.gitignore
!/local_handoff_package/README.md

# Flutter and Dart generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/
**/ios/Flutter/.last_build_id
/frontend/build/
/frontend/.flutter_build/
app.*.symbols
app.*.map.json
/frontend/android/app/debug/
/frontend/android/app/profile/
/frontend/android/app/release/

# Editors and operating systems
.idea/
.vscode/
.vs/
.atom/
.history/
.svn/
.DS_Store
desktop.ini
*.iml
*.ipr
*.iws
*.swp
~$*
~*.tmp

# Other generated files
*.class
*.log
.buildlog/
migrate_working_dir/
