# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.env

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
.local-run/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release


# Ignore virtual environment folders
venv/
env/
backend/*.db
backend/managed_assets/
backend/data/study_accounts.json
backend/data/study_accounts_import_report*.json
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
backend/study_exports/

# Ignore Python cache files
__pycache__/
*.py[cod]

# Secrets
.env


# Python venvs
env/
venv/

# OS / Editor
.DS_Store
*.pyc
__pycache__/

# Temporary Microsoft Office/editor lock files
~$*
~*.tmp

# Ignore VSCode settings folder
.vscode/
.vs/

# Ignore Windows folder settings
desktop.ini

# Generated local SQA exports (the maintained workbook remains at repository root)
outputs/
/output/
/tmp/

# OneDrive-synchronized local PostgreSQL handoff artifacts. The directory and
# its instructions are tracked, but dumps, manifests, and device locks are not.
/local_database_backups/*
!/local_database_backups/.gitignore
!/local_database_backups/README.md



# You may also ignore generated Flutter plugin files if they are re-generated,
# but usually, it's fine to commit those if they are needed.
