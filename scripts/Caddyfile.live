# Single public address for the self-hosted lab PC. Cloudflare Tunnel sends
# rpl.ponkoj.com here; /api/* goes to the API without the prefix, and every
# other path goes to the Flutter web server. Cloudflare provides HTTPS.
{
	admin off
	auto_https off
}

# Any Host header (the tunnel sends rpl.ponkoj.com), but only on localhost.
:8080 {
	bind 127.0.0.1
	handle_path /api/* {
		reverse_proxy 127.0.0.1:5100
	}
	handle {
		# Cloudflare's Browser Cache TTL replaces a plain no-cache header, which
		# kept browsers on an old app for hours after a deploy. It leaves
		# private/no-store alone, so every page load checks for the new build.
		header Cache-Control "private, no-cache, no-store, must-revalidate"
		reverse_proxy 127.0.0.1:8180 {
			header_down -Cache-Control
		}
	}
}
